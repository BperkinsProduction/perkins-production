---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Facts from '../components/Facts.astro';
import ThreeWays from '../components/ThreeWays.astro';
import LevelFinder from '../components/LevelFinder.astro';
import Memberships from '../components/Memberships.astro';
import Reviews from '../components/Reviews.astro';
import Cocktail from '../components/Cocktail.astro';
import RedLight from '../components/RedLight.astro';
import FirstVisit from '../components/FirstVisit.astro';
import Faq from '../components/Faq.astro';
import Locations from '../components/Locations.astro';
import Join from '../components/Join.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Nav />

  <main id="main" tabindex="-1">
    <Hero />
    <Facts />
    <ThreeWays />
    <LevelFinder />
    <Memberships />
    <Reviews />
    <Cocktail />
    <RedLight />
    <FirstVisit />
    <Faq />
    <Locations />
    <Join />
  </main>

  <Footer />
</Base>
