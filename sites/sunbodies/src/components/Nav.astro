---
// The sticker-style menu bar. The small logo stays hidden while the big hero logo
// is on screen, then slides in (site.js toggles the logo-in class).
import { money, special } from '../data/salon';
import { asset } from '../lib/paths';
---
<header class="nav" id="nav">
  <a class="brand" href="#top" aria-label="Sunbodies Tanning Salon, back to top"><img src={asset('logo-light.svg')} alt="Sunbodies Tanning Salon" width="119" height="40"></a>
  <nav aria-label="Main">
    <a href="#levels">Levels</a>
    <a href="#memberships">Memberships</a>
    <a href="#first-visit">First visit</a>
    <a href="#locations">Locations</a>
  </nav>
  <span class="live" id="navLive" aria-live="polite">Hours today</span>
  <a class="btn btn-gold" href="#join">Claim {money(special.price)}</a>
</header>
