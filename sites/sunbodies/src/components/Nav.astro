---
// The floating pill menu, plus the big logo that flies up into it as the hero scrolls.
import { money, special } from '../data/salon';
import { asset } from '../lib/paths';
---
<header class="nav" id="nav">
  <a class="brand" href="#top" aria-label="Sunbodies Tanning Salon, back to top"><img src={asset('logo-dark.svg')} alt="Sunbodies Tanning Salon" width="119" height="40"></a>
  <nav aria-label="Main">
    <a href="#levels">Levels</a>
    <a href="#memberships">Memberships</a>
    <a href="#first-visit">First visit</a>
    <a href="#locations">Locations</a>
  </nav>
  <span class="live" id="navLive" aria-live="polite">Hours today</span>
  <a class="btn btn-gold" href="#join">Claim {money(special.price)}</a>
</header>

<div class="flyer" id="flyer" aria-hidden="true"><img class="l" src={asset('logo-light.svg')} alt="" width="1750" height="588"><img class="d" src={asset('logo-dark.svg')} alt="" width="1750" height="588"></div>
