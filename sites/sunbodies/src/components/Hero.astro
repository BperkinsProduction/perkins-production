---
// The opening screen: the real logo on a slowly turning sunburst, with the gym
// bundle as the headline. Nothing here is a photo.
import { money, special } from '../data/salon';
import { asset } from '../lib/paths';
const price = money(special.price);
---
<section class="hero" id="top" aria-label={`Tan. Train. ${price}`}>
  <div class="rays-bg" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-center">
    <img class="hero-logo" id="heroLogo" src={asset('logo-light.svg')} alt="Sunbodies Tanning Salon" width="1750" height="588">
    <h1>Tan. Train. <span class="num">{price}</span></h1>
    <p class="hero-sub">Unlimited tanning and Sports Inn Fitness, one membership, Greencastle and Chambersburg.</p>
    <div class="ctas">
      <a class="btn btn-gold btn-big" href="#join">Claim {price} unlimited</a>
      <a class="btn btn-line btn-big" href="#levels">Find your level</a>
    </div>
  </div>
</section>
