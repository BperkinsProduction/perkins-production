---
import '../styles/global.css';
import { site } from '../data/salon';
import { asset } from '../lib/paths';
const pageUrl = new URL(import.meta.env.BASE_URL, Astro.site).href;
const ogImage = new URL(asset('og.jpg'), Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{site.title}</title>
<meta name="description" content={site.description}>
<meta name="theme-color" content="#FFC93C">
<meta name="robots" content="noindex, nofollow">
<meta property="og:type" content="website">
<meta property="og:title" content={site.ogTitle}>
<meta property="og:description" content={site.ogDescription}>
<meta property="og:url" content={pageUrl}>
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Cg fill='%23EFA53C'%3E%3Ccircle cx='32' cy='32' r='14'/%3E%3Cg stroke='%23C4531D' stroke-width='5' stroke-linecap='round'%3E%3Cpath d='M32 4v8M32 52v8M4 32h8M52 32h8M12 12l6 6M46 46l6 6M52 12l-6 6M18 46l-6 6'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bowlby+One&family=Figtree:wght@400;500;600;700;800&display=swap">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<div class="grain" aria-hidden="true"></div>

<slot />

<script>
  import '../scripts/site.js';
</script>
</body>
</html>
