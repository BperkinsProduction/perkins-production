---
import { depositRate } from '../data/prices.js';
import { shop } from '../data/shop.js';
const pct = depositRate * 100;
---
<section id="quote" data-reveal>
  <div class="wrap">
    <span class="label">Build your quote</span>
    <h2>Your price, then your day.</h2>
    <p class="lede">Pick your size and service, add any extras, choose an open drop off time, and hold it with half down. No phone tag.</p>

    <form class="builder" id="builder" novalidate>
      <div>
        <div class="step">
          <h3><i>1</i>Vehicle size</h3>
          <div class="choices" id="qSizes"></div>
          <div class="finder">
            <label for="carFind2">Not sure? Type your car</label>
            <input type="text" id="carFind2" data-finder placeholder="2019 Chevy Tahoe" autocomplete="off" spellcheck="false">
            <p class="finder-out" aria-live="polite"></p>
          </div>
        </div>
        <div class="step">
          <h3><i>2</i>Service</h3>
          <div id="qServices"></div>
        </div>
        <div class="step">
          <h3><i>3</i>Add ons <small style="font-family:Inter;letter-spacing:0;text-transform:none;color:var(--muted);font-weight:400">(optional)</small></h3>
          <div class="addons" id="qAddons"></div>
        </div>
        <div class="step">
          <h3><i>4</i>Pick your day and drop off</h3>
          <div class="days" id="qDays" role="radiogroup" aria-label="Day"></div>
          <div class="slots" id="qSlots" role="radiogroup" aria-label="Drop off time"></div>
          <p class="fine" id="slotNote"></p>
        </div>
        <div class="step">
          <h3><i>5</i>Your details</h3>
          <div class="fields">
            <label class="f full">Year, make and model
              <input type="text" id="fCar" placeholder="2021 Ford F-150" autocomplete="off" required>
            </label>
            <label class="f">Your name
              <input type="text" id="fName" autocomplete="name" required>
            </label>
            <label class="f">Mobile number
              <input type="tel" id="fPhone" autocomplete="tel" placeholder="(301) 555-0100" required>
            </label>
            <label class="f full">Anything Chad should know?
              <textarea id="fNotes" placeholder="Dog hair in the back seat, kids spilled a milkshake, getting it ready to sell..."></textarea>
            </label>
            <div class="f full photos">
              <span>Photos <small>(optional, up to 4)</small></span>
              <div class="shots" id="shots">
                <label class="shot-add" for="fPhotos"><span aria-hidden="true">+</span>Add photos</label>
              </div>
              <input type="file" id="fPhotos" accept="image/*" multiple hidden>
              <p class="fine">Snap the back seat, the scratch, the dog hair. {shop.owner} sees it before he confirms your price.</p>
            </div>
          </div>
        </div>
      </div>

      <aside class="summary" aria-live="polite">
        <h3>Your quote</h3>
        <div class="lines" id="sumLines"></div>
        <div class="total"><span id="sumLabel">Total</span><b id="sumTotal">$0</b></div>
        <div class="deposit" id="sumDeposit"></div>
        <p class="fine" id="sumFine">Final price is confirmed when Chad sees the vehicle. Heavily soiled vehicles may cost more.</p>
        <button class="btn btn-blue" type="submit" id="sendBtn">Book this appointment</button>
        <p class="err" id="err" role="alert"></p>
      </aside>
    </form>

    <div class="checkout" id="checkout" hidden>
      <div class="preview-flag"><b>PREVIEW ONLY, NO CARD IS CHARGED.</b> On the real site, Square's secure card checkout opens here. This demo never asks for card details.</div>
      <div class="co-card">
        <span class="label">Hold your day</span>
        <h3 id="coHead"></h3>
        <div class="lines" id="coLines"></div>
        <div class="co-split">
          <div><span>Due today, {pct}%</span><b id="coNow"></b></div>
          <div><span id="coLaterLabel">Due at pickup</span><b id="coLater"></b></div>
        </div>
        <div class="co-actions">
          <button class="btn btn-blue" type="button" id="payBtn">Pay deposit</button>
          <button class="btn btn-ghost" type="button" id="coBack">Change something</button>
        </div>
        <p class="fine">Card payments run through Square. Chad gets the booking and the deposit at the same time.</p>
      </div>
    </div>

    <div class="result" id="result">
      <div class="preview-flag"><b>PREVIEW ONLY, NOTHING WAS SENT OR CHARGED.</b> This is a design concept. On the real site the booking and the deposit go straight to Chad, and the time slot is taken off the calendar.</div>
      <div class="result-grid">
        <div class="result-card">
          <h3>What you'd see</h3>
          <p style="margin-top:0;color:var(--white);font-size:1.15rem;font-family:Archivo;font-weight:800" id="rHead"></p>
          <div class="lines" id="rLines"></div>
          <div class="total"><span id="rLabel">Total</span><b id="rTotal"></b></div>
          <p class="fine" id="rNext"></p>
          <button class="btn btn-ghost" type="button" id="againBtn" style="width:100%;margin-top:8px">Start another quote</button>
        </div>
        <div class="result-card">
          <h3>What lands on Chad's phone</h3>
          <div class="phone">
            <div class="who">New booking &middot; twelvewestdetail.com</div>
            <div class="bubble" id="rText"></div>
            <div class="bubble me" id="rReply"></div>
          </div>
          <p class="fine">The booking arrives already paid for: the vehicle, the service, the price, the day and the time, with half the money in. No back and forth.</p>
        </div>
        <div class="result-card texts">
          <h3>Texts your customer gets, on their own</h3>
          <ol class="timeline" id="rTexts"></ol>
          <p class="fine">Sent automatically from the shop's number. {shop.owner} only taps one button: "Ready."</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import "../scripts/quote.js";
</script>
