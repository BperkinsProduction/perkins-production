---
import { img } from '../lib/paths.js';
import { shop } from '../data/shop.js';
import FacebookIcon from './FacebookIcon.astro';
---
<header class="top">
  <div class="wrap">
    <a href="#top" aria-label="Twelve West Detail home"><img src={img("logo.png")} alt="Twelve West Detail"></a>
    <nav>
      <a href="#packages">Packages</a>
      <a href="#ceramic">Ceramic</a>
      <a href="#work">Our Work</a>
      <a href="#visit">Visit</a>
      <a class="fb" href={shop.facebook} target="_blank" rel="noopener" aria-label={`${shop.name} on Facebook`}><FacebookIcon /></a>
      <a class="btn btn-blue" href="#quote">Build your quote</a>
    </nav>
  </div>
</header>
