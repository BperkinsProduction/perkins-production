---
import { img } from '../lib/paths.js';
import { gallery, interiors } from '../data/photos.js';
import { shop } from '../data/shop.js';
import Photo from './Photo.astro';

// One list for the full screen viewer: every outside photo, then the inside ones.
const big = (file) => img('w/' + file.replace(/\.jpg$/, '') + '-960.webp');
const viewer = [...gallery, ...interiors].map((p) => ({ src: big(p.file), alt: p.alt, caption: p.caption }));
const at = (p) => viewer.findIndex((v) => v.src === big(p.file));
// How wide each photo shows, so the browser picks the right copy.
const tileSizes = (p) => (p.feature ? '(max-width: 860px) calc(100vw - 32px), 585px' : '(max-width: 860px) calc(50vw - 21px), 290px');
const open = (p) => `Open ${p.caption} full size`;
---
<section id="work" data-reveal>
  <div class="wrap">
    <span class="label">Out of the bay</span>
    <h2>Recent work</h2>
    <p class="lede">Every one of these was shot right after the detail, under our lights in Walkersville. Tap any photo to see it full size.</p>
    <div class="fbfeed" id="fbFeed" data-endpoint="/api/facebook-photos?site=twelvewest" data-page={shop.facebook} hidden>
      <h3 class="inside-title" style="margin-top:0">Just posted on Facebook</h3>
      <div class="fbgrid" id="fbGrid"></div>
    </div>
    <div class="gallery">
      {gallery.filter((p) => !p.viewerOnly).map((p) => (
        <figure class:list={[p.feature && `feat ${p.feature}`]}>
          <Photo file={p.file} alt={p.alt} sizes={tileSizes(p)} /><figcaption>{p.caption}</figcaption>
          <button class="gopen" type="button" data-view={at(p)} aria-label={open(p)}></button>
        </figure>
      ))}
    </div>

    <h3 class="inside-title">Inside, too.</h3>
    <p class="lede" style="margin-bottom:1.2rem">Steam cleaned plastics, conditioned leather, shampooed carpets and seats. The part of the car you actually sit in.</p>
    <div class="inside">
      {interiors.map((p) => (
        <figure>
          <Photo file={p.file} alt={p.alt} sizes="(max-width: 760px) calc(50vw - 21px), 290px" /><figcaption>{p.caption}</figcaption>
          <button class="gopen" type="button" data-view={at(p)} aria-label={open(p)}></button>
        </figure>
      ))}
    </div>
    <button class="btn btn-ghost see-all" type="button" data-view="0">See all {viewer.length} photos</button>
    <p class="fine" style="margin-top:14px">Photos from <a href={shop.facebook} target="_blank" rel="noopener">{shop.name} on Facebook</a>. Once Facebook is connected, new photos {shop.owner} posts there show up here on their own, a few times a day.</p>
  </div>
</section>

<dialog class="viewer" id="viewer" aria-label="Photos" data-photos={JSON.stringify(viewer)}>
  <figure>
    <img alt="">
    <figcaption><b></b><span class="vcount" aria-live="polite"></span></figcaption>
  </figure>
  <button class="vbtn vclose" type="button" aria-label="Close" data-close>&times;</button>
  <button class="vbtn vprev" type="button" aria-label="Previous photo" data-step="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
  <button class="vbtn vnext" type="button" aria-label="Next photo" data-step="1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
</dialog>

<script>
  import "../scripts/facebook-feed.js";
  import "../scripts/viewer.js";
</script>
