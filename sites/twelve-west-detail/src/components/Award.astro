---
import { shop } from '../data/shop.js';
import FacebookIcon from './FacebookIcon.astro';
---
<div class="award">
  <div class="wrap">
    <div class="badge">
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" aria-hidden="true"><circle cx="24" cy="19" r="13"/><path d="M24 11l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.2-4.1 5.8-.8z" fill="currentColor" stroke="none"/><path d="M16 29l-4 15 7-3 5 5 2-10M32 29l4 15-7-3-5 5"/></svg>
      <div><b>{shop.award.title}</b><span>{shop.award.detail}</span></div>
    </div>
    <a class="badge" href={shop.reviews.url} target="_blank" rel="noopener">
      <FacebookIcon />
      <div><b>{shop.reviews.recommend} recommend on Facebook</b><span>{shop.reviews.count} reviews and {shop.followers} followers. Read them on Facebook</span></div>
    </a>
  </div>
</div>
