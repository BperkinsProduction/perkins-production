---
import { img } from '../lib/paths.js';
---
<section style="padding-top:0" data-reveal>
  <div class="wrap">
    <div class="specialty">
      <img src={img("rv.jpg")} alt="A large motorhome detailed by Twelve West Detail" loading="lazy">
      <div>
        <span class="label">Specialty vehicles</span>
        <h2>RVs, trailers, bikes and classics.</h2>
        <p>We detail more than everyday cars and trucks. Motorhomes, campers, motorcycles and classic cars are priced by the job. Pick "Specialty vehicle" in the quote builder, tell us what it is, and Chad will text you a price.</p>
        <a class="btn btn-blue" href="#quote" data-pick="specialty">Ask about yours</a>
      </div>
    </div>
  </div>
</section>
