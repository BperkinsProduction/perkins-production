---
import { img, page } from '../lib/paths.js';
import { packages, coatings, depositRate, addon, money } from '../data/prices.js';
import { shop } from '../data/shop.js';
import { agencyLines, agencyTotal, yourPrice, payments, priceNote, dated } from '../data/appraisal.js';
import '../styles/proposal.css';
const cheapest = packages[0];
const priciest = packages[packages.length - 1];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>Twelve West Detail Website Proposal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Manrope:wght@400;500;600;700&family=Josefin+Slab:wght@400;600&display=swap">
</head>
<body>
<div class="wrap">
  <header>
    <svg class="pp-logo" viewBox="0 0 900 280" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Perkins Production"><defs><linearGradient id="gGnav" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#d4b87a"/><stop offset="50%" stop-color="#c9a96e"/><stop offset="100%" stop-color="#b8944f"/></linearGradient></defs><g transform="translate(20,40)"><g stroke="url(#gGnav)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"><rect x="40" y="35" width="120" height="82" rx="6"/><circle cx="100" cy="41.5" r="0.9" fill="url(#gGnav)" stroke="none"/><rect x="46" y="47" width="108" height="64" rx="3" opacity="0.45"/><g opacity="0.7"><rect x="49.5" y="51" width="4.5" height="3.2" rx="0.6"/><rect x="49.5" y="57" width="4.5" height="3.2" rx="0.6"/><rect x="49.5" y="63" width="4.5" height="3.2" rx="0.6"/><rect x="49.5" y="69" width="4.5" height="3.2" rx="0.6"/><rect x="49.5" y="75" width="4.5" height="3.2" rx="0.6"/><rect x="49.5" y="81" width="4.5" height="3.2" rx="0.6"/><rect x="49.5" y="87" width="4.5" height="3.2" rx="0.6"/><rect x="49.5" y="93" width="4.5" height="3.2" rx="0.6"/><rect x="49.5" y="99" width="4.5" height="3.2" rx="0.6"/><rect x="49.5" y="105" width="4.5" height="3.2" rx="0.6"/></g><circle cx="105" cy="79" r="24"/><circle cx="105" cy="79" r="18" opacity="0.85"/><circle cx="105" cy="79" r="12" opacity="0.7"/><circle cx="105" cy="79" r="5"/><path d="M102.6 76.2L102.6 81.8L107.4 79Z" fill="url(#gGnav)" stroke="url(#gGnav)" stroke-width="0.6"/><path d="M88 70A22 22 0 0 1 99 60" stroke="#fff" stroke-width="1.2" opacity="0.5"/><line x1="36" y1="120" x2="164" y2="120"/><path d="M36 120L164 120L172 138Q172 142 168 142L32 142Q28 142 28 138Z"/><line x1="50" y1="126" x2="150" y2="126" opacity="0.35"/><line x1="48" y1="130" x2="152" y2="130" opacity="0.35"/><rect x="86" y="134.5" width="28" height="4" rx="1" opacity="0.55"/><line x1="92" y1="142" x2="108" y2="142" opacity="0.6" stroke-width="1.8"/></g></g><g transform="translate(240,0)"><text x="0" y="120" font-family="Cormorant Garamond,Georgia,serif" font-size="84" font-weight="600" letter-spacing="2" fill="#e8e8e8">PERKINS</text><line x1="0" y1="140" x2="420" y2="140" stroke="url(#gGnav)" stroke-width="1.2"/><text x="0" y="180" font-family="Cormorant Garamond,Georgia,serif" font-size="22" font-weight="400" letter-spacing="14" fill="#999">PRODUCTION</text><line x1="0" y1="208" x2="20" y2="208" stroke="url(#gGnav)" stroke-width="1.5"/><text x="30" y="212" font-family="Josefin Slab,Georgia,serif" font-size="11" font-weight="400" letter-spacing="3.5" fill="#666">PHOTO + VIDEO + DESIGN</text></g></svg>
    <div class="eyebrow">Website Proposal &middot; {dated}</div>
    <h1>A new home for<br>Twelve West Detail</h1>
    <p class="muted" style="font-size: 17.5px;">Every price up front, a quote that builds itself, and booking requests that land on your phone with the car, the package and the day already filled in.</p>
    <div class="si-chip" style="background:#000"><img src={img("logo.png")} alt="Twelve West Detail logo"></div>
    <div class="prepared">
      <div><b>Prepared for</b>Chad &middot; Twelve West Detail, Walkersville MD</div>
      <div><b>Prepared by</b>Brice Perkins &middot; Perkins Production</div>
    </div>
    <div class="findit">
      <div>
        <div class="k">Your demo site</div>
        <a class="big" href={page("")}>perkinsproduction.com/<wbr>twelvewest</a>
        <p>Type that into any phone or browser, or scan the code. Everything clicks: tap a vehicle size and every price changes, build a quote with add ons, and send a booking request to see the text you would get.</p>
        <a class="btn" href={page("")}>Open the demo site</a>
      </div>
      <div class="qr"><svg viewBox="0 0 37 37" class="qrsvg"><title>QR code for perkinsproduction.com/twelvewest</title><path fill="#fff" d="M0 0h37v37h-37z"/><path class="qrline" stroke="#0b0a09" d="M2 2.5h7m1 0h4m2 0h3m1 0h2m2 0h2m2 0h7m-33 1h1m5 0h1m2 0h1m2 0h1m1 0h2m1 0h1m3 0h1m1 0h1m2 0h1m5 0h1m-33 1h1m1 0h3m1 0h1m1 0h1m1 0h4m3 0h3m3 0h2m1 0h1m1 0h3m1 0h1m-33 1h1m1 0h3m1 0h1m1 0h4m2 0h1m1 0h2m1 0h1m2 0h2m2 0h1m1 0h3m1 0h1m-33 1h1m1 0h3m1 0h1m5 0h9m2 0h1m2 0h1m1 0h3m1 0h1m-33 1h1m5 0h1m1 0h1m1 0h2m1 0h1m1 0h1m1 0h6m1 0h1m1 0h1m5 0h1m-33 1h7m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h7m-25 1h1m2 0h3m1 0h4m1 0h2m2 0h1m-24 1h1m1 0h1m1 0h5m1 0h1m2 0h3m3 0h2m1 0h1m1 0h3m1 0h2m1 0h1m-32 1h1m1 0h3m2 0h6m6 0h1m1 0h1m1 0h4m4 0h1m-33 1h1m2 0h2m1 0h1m1 0h1m6 0h1m1 0h1m1 0h2m1 0h1m1 0h5m1 0h1m1 0h1m-32 1h2m2 0h1m1 0h3m2 0h1m1 0h1m2 0h1m1 0h3m1 0h2m3 0h2m-28 1h1m1 0h1m1 0h1m1 0h3m1 0h1m3 0h1m4 0h1m1 0h1m1 0h2m2 0h1m2 0h1m-33 1h4m1 0h1m4 0h2m1 0h1m1 0h2m2 0h3m2 0h1m1 0h1m1 0h1m2 0h2m-32 1h1m1 0h1m1 0h3m1 0h2m2 0h3m4 0h7m2 0h3m-31 1h2m5 0h3m1 0h1m1 0h1m1 0h1m1 0h1m2 0h1m1 0h2m1 0h1m1 0h1m2 0h1m-31 1h1m1 0h1m2 0h1m1 0h1m7 0h2m1 0h1m1 0h2m1 0h1m1 0h1m1 0h1m2 0h1m-32 1h1m2 0h1m3 0h4m1 0h1m1 0h1m6 0h1m1 0h1m3 0h1m1 0h1m1 0h1m-31 1h1m1 0h1m1 0h2m4 0h2m2 0h2m1 0h1m2 0h1m3 0h1m4 0h3m-33 1h2m2 0h1m7 0h1m2 0h1m2 0h2m1 0h2m1 0h4m3 0h1m-30 1h8m2 0h1m1 0h1m1 0h2m2 0h2m1 0h1m1 0h1m5 0h1m-31 1h1m3 0h1m2 0h3m1 0h1m2 0h2m3 0h1m3 0h4m1 0h4m-33 1h2m2 0h1m1 0h8m4 0h2m1 0h1m4 0h1m1 0h3m1 0h1m-32 1h2m2 0h1m1 0h6m1 0h1m2 0h1m1 0h1m1 0h4m3 0h2m1 0h2m-33 1h1m1 0h3m1 0h1m5 0h1m2 0h3m3 0h1m1 0h6m2 0h1m-24 1h3m1 0h1m2 0h1m3 0h4m1 0h1m3 0h2m1 0h2m-33 1h7m1 0h1m1 0h1m13 0h1m1 0h1m1 0h4m-32 1h1m5 0h1m1 0h3m2 0h1m1 0h2m1 0h1m1 0h3m1 0h1m3 0h1m2 0h1m-32 1h1m1 0h3m1 0h1m2 0h1m2 0h1m1 0h4m2 0h3m1 0h6m2 0h1m-33 1h1m1 0h3m1 0h1m1 0h1m3 0h1m3 0h1m1 0h1m3 0h3m1 0h1m1 0h4m-32 1h1m1 0h3m1 0h1m2 0h3m1 0h2m2 0h1m4 0h4m2 0h2m2 0h1m-33 1h1m5 0h1m1 0h1m1 0h1m1 0h1m1 0h3m1 0h4m1 0h4m-27 1h7m2 0h1m3 0h1m1 0h1m1 0h1m3 0h1m1 0h3m2 0h2m1 0h1"/></svg><span>Scan with your phone</span></div>
    </div>
  </header>

  <section>
    <div class="eyebrow"><span class="num">01</span> Where things stand today</div>
    <h2>The work is great. The website hides it.</h2>
    <p class="muted">I went through twelvewestdetail.com on a computer and on my phone. Your photos are some of the best I have seen from a detailer around here, and you were voted the best in Frederick County. The site makes people work to find any of that.</p>
    <div style="margin-top: 22px;">
      <div class="fault"><span class="tick">&#10022;</span><span>GoDaddy runs an ad for its own website builder across the top of your site. It is the first thing every customer reads.</span></div>
      <div class="fault"><span class="tick">&#10022;</span><span>On a phone, the first screen is your logo and empty dark space. No photo, no prices, no button to book.</span></div>
      <div class="fault"><span class="tick">&#10022;</span><span>The page opens with a form that only asks for a name, email and phone. Every request turns into a call or a text to find out what car, what package and what day.</span></div>
      <div class="fault"><span class="tick">&#10022;</span><span>Every price is Small, Mid, Large or XL, but nothing says which size a car is. That is one more question you answer by text.</span></div>
      <div class="fault"><span class="tick">&#10022;</span><span>Your 2020 Best of the Best win is nowhere on the site, and Google sees a page titled "twelve west detail" with no description, so searches like "detailing Walkersville" have little to go on.</span></div>
    </div>
  </section>

  <section>
    <div class="eyebrow"><span class="num">02</span> What you get</div>
    <h2>Everything in the demo, built for real</h2>
    <div class="gets two">
      <div class="get">
        <h3>A website built for phones</h3>
        <p>It opens on a film of your bay: scroll down and the camera comes down from your lights onto the Corvette. New photos you post on Facebook show up on the site on their own, a few times a day. Packages, ceramic coating, specialty vehicles, hours and directions, with a call button that stays at the bottom of the screen.</p>
      </div>
      <div class="get">
        <h3>Prices that answer the question</h3>
        <p>Your full price list, all {packages.length} packages from the {money(cheapest.prices[0])} {cheapest.name.replace("The ", "")} to the {money(priciest.prices[3])} {priciest.name.replace("The ", "")}. Tap a vehicle size and every price on the page changes, with example cars so people know which size they are.</p>
      </div>
      <div class="get">
        <h3>A quote that builds itself</h3>
        <p>Customers pick a size, a package and any of your add ons, like pet hair from {money(addon("pet").price)} or headlights at {money(addon("headlight").price)} each, and see the total. Add ons a package already covers show as included, so nobody pays twice.</p>
      </div>
      <div class="get">
        <h3>Booking requests that make sense</h3>
        <p>The request comes to your phone and email as one message: name, number, year make and model, the package, the price and the day they want. You text back a time. Sundays are blocked.</p>
      </div>
      <div class="get">
        <h3>Ceramic deposits online</h3>
        <p>Coating jobs hold the day with your {depositRate * 100}% non refundable deposit, paid by card when they book. On a {money(coatings[0].from)} coating that is {money(Math.round(coatings[0].from * depositRate))} in hand before the car shows up.</p>
      </div>
      <div class="get">
        <h3>Found on Google</h3>
        <p>A real title and description, your award and your town on the page, and your Google listing pointed at the new site. Your domain stays twelvewestdetail.com.</p>
      </div>
    </div>
  </section>

  <section>
    <div class="eyebrow"><span class="num">03</span> The appraisal</div>
    <h2>What it's worth, and what you pay</h2>
    <p class="muted">Here's what a small web agency would typically charge to build each piece, next to my price.</p>
    <div class="val">
      {agencyLines.map((l) => <div class="line"><span>{l.label}</span><b>{money(l.amount)}</b></div>)}
      <div class="line total"><span>Typical agency price</span><b>{money(agencyTotal)}</b></div>
    </div>
    <div class="yourprice">
      <span class="k">Your price, one time</span>
      <span class="amt">{money(yourPrice)}</span>
      <p>{payments.map((p, i) => <>{i > 0 && ', '}<b style="color:var(--ink)">{money(p.amount)}</b> {p.when.toLowerCase()}</>)}. {priceNote}</p>
    </div>
    <p class="fine">Typical prices are estimates for custom work from a small web agency. Hosted booking apps for detailers usually run $30 to $100 a month, and you still would not get your own price list working like this.</p>

    <h3 style="margin-top: 44px;">After launch</h3>
    <div style="margin-top: 12px;">
      <div class="row"><span class="k">Hosting</span><span><b>$0 per month</b> &middot; same setup as the JFK 50 Mile race site I built. If you pay GoDaddy for the website builder today, that stops.</span></div>
      <div class="row"><span class="k">Domain</span><span><b>About $22 a year</b> &middot; you keep twelvewestdetail.com at GoDaddy, where it renews in February 2027</span></div>
      <div class="row"><span class="k">Online payments</span><span><b>3.3% + 30&cent; per card payment</b> &middot; Square's standard online rate, nothing added. Only charged on deposits people pay online.</span></div>
      <div class="row"><span class="k">Photo + video</span><span><b>Optional add on</b> &middot; a Perkins Production shoot in your bay: a short video of a car coming out finished for the top of the site, plus before and after shots. Quoted separately.</span></div>
    </div>
  </section>

  <section>
    <div class="eyebrow"><span class="num">04</span> The hours it hands back</div>
    <h2>What stops being your job</h2>
    <div style="margin-top: 22px;">
      <div class="row"><span class="k">"How much for mine?"</span><span><b>Texts asking for prices, now a link.</b> People see their exact price for their size before they ever message you.</span></div>
      <div class="row"><span class="k">Back and forth</span><span><b>Three or four texts per booking, now one.</b> The request already says what car, what package and what day.</span></div>
      <div class="row"><span class="k">Deposits</span><span><b>Chasing coating deposits, now paid at booking.</b> The money is in before the day is held.</span></div>
    </div>
  </section>

  <section>
    <div class="eyebrow"><span class="num">05</span> Timeline</div>
    <h2>Live before spring detailing season</h2>
    <div style="margin-top: 22px;">
      <div class="row"><span class="k">First</span><span><b>Fix the Google basics on the site you have now.</b> A real page title and description this week. Needs 10 minutes with you in your GoDaddy account.</span></div>
      <div class="row"><span class="k">November</span><span>Walk through the demo together. Confirm which cars count as Small, Mid, Large and XL, pick your favorite photos, and pull a few real reviews from Facebook.</span></div>
      <div class="row"><span class="k">December to January</span><span>Build the site, the quote builder and the booking requests</span></div>
      <div class="row"><span class="k">February</span><span>Set up Square deposits and test with a few of your regular customers. Point twelvewestdetail.com at the new site before it renews.</span></div>
      <div class="row"><span class="k">March</span><span>Launch, post it on Facebook and Instagram, and update your Google listing before the spring rush</span></div>
    </div>
  </section>

  <div class="close">
    <h2>Ready when you are</h2>
    <p>If you like what you see, just text me and we'll set up a time to go through it together. The demo stays up at perkinsproduction.com/twelvewest so you can show anyone you want.</p>
    <div class="closebtns">
      <a class="btn" href="mailto:Brice@perkinsproduction.com?subject=Twelve%20West%20Detail%20website">Email Brice</a>
      <a class="btn ghost" href="tel:+12408181955">Call or text (240) 818-1955</a>
    </div>
  </div>

  <footer>
    <span><span class="gold">Perkins Production</span> &middot; Photo + Video + Design</span>
    <span>Prepared {dated} for {shop.name}</span>
  </footer>
</div>
</body>
</html>
