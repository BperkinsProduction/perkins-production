<script is:inline>
/* Folder URLs need their trailing slash, or the relative asset paths point one level up. */
if (!/\/$|\.html$/.test(location.pathname)) location.replace(location.pathname + "/" + location.search + location.hash);
</script>
<script is:inline>
/* Decide the hero mode before first paint, so there is no flash of the wrong layout.
   These five gates are identical, character for character, to the CSS gate further down. */
(function(){
  var G = ["(max-width: 720px)","(orientation: portrait) and (max-width: 1024px)","(orientation: portrait) and (pointer: coarse)","(orientation: landscape) and (pointer: coarse) and (max-height: 560px)","(prefers-reduced-motion: reduce)"];
  window.__HERO_GATES = G;
  var gated = G.some(function(q){ return matchMedia(q).matches; });
  if (!gated) document.documentElement.classList.add("scrub");
  document.documentElement.classList.add("js");
})();
</script>
