{"@type":"Dentist","name":"Robinwood Dental Center, Middletown","telephone":"+1-240-313-9660","address":{"@type":"PostalAddress","streetAddress":"4310 Old National Pike","addressLocality":"Middletown","addressRegion":"MD","postalCode":"21769","addressCountry":"US"},"openingHours":["Mo-Th 08:00-17:00","Fr 08:00-14:00"]},
