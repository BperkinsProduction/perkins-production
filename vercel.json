{
  "functions": {
    "api/upload.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/se/",
      "destination": "https://structural-elements-anatomy-study.vercel.app/se/index.html"
    },
    {
      "source": "/se",
      "destination": "https://structural-elements-anatomy-study.vercel.app/se/index.html"
    },
    {
      "source": "/se/:path*",
      "destination": "https://structural-elements-anatomy-study.vercel.app/se/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/se/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:site([Ss][Pp][Oo][Rr][Tt][Ss]-?[Ii][Nn][Nn])",
      "destination": "/concepts/sports-inn.html",
      "permanent": false
    },
    {
      "source": "/:site([Ss][Pp][Oo][Rr][Tt][Ss]-?[Ii][Nn][Nn])/",
      "destination": "/concepts/sports-inn.html",
      "permanent": false
    },
    {
      "source": "/:site([Ss][Pp][Oo][Rr][Tt][Ss]-?[Ii][Nn][Nn])/:page(proposal|price|Proposal|Price)",
      "destination": "/concepts/sports-inn-proposal.html",
      "permanent": false
    },
    {
      "source": "/:site([Ss][Pp][Oo][Rr][Tt][Ss]-?[Ii][Nn][Nn])/:page(proposal|price|Proposal|Price)/",
      "destination": "/concepts/sports-inn-proposal.html",
      "permanent": false
    },
    {
      "source": "/:site([Ss][Uu][Nn]-?[Bb][Oo][Dd][Ii][Ee][Ss])",
      "destination": "/concepts/sunbodies/",
      "permanent": false
    },
    {
      "source": "/:site([Ss][Uu][Nn]-?[Bb][Oo][Dd][Ii][Ee][Ss])/",
      "destination": "/concepts/sunbodies/",
      "permanent": false
    },
    {
      "source": "/concepts/sunbodies",
      "destination": "/concepts/sunbodies/",
      "permanent": false
    },
    {
      "source": "/concepts/robinwood",
      "destination": "/concepts/robinwood/",
      "permanent": false
    }
  ]
}
