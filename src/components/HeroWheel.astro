---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Logo from './Logo.astro';
import { getWheelSites } from '../utils/work';
import { text } from '../utils/text';

const sites = await getWheelSites();

// Card widths: min(48vw, 720px) on desktop, about 52vw on phones (see .wheel-card in site.css)
const MOBILE = '(max-width: 720px), (orientation: portrait)';
const desktop = { widths: [480, 800, 1200, 1600], sizes: '(min-width: 1500px) 720px, 48vw' };
const mobile = { widths: [320, 480, 640, 780], sizes: '52vw' };

// One <source> srcset per format, smallest format first
type Format = 'avif' | 'webp' | 'jpeg';
async function sources(src: ImageMetadata, opts: { widths: number[]; sizes: string }, formats: Format[]) {
    return Promise.all(formats.map(async (format) => {
        const img = await getImage({ src, format, ...opts });
        return { type: `image/${format}`, srcset: img.srcSet.attribute };
    }));
}

const shots = await Promise.all(sites.map(async (site) => ({
    // Mobile needs a jpeg source too, or old browsers would fall through to the desktop <img>
    mobile: await sources(site.shots.mobile, mobile, ['avif', 'webp', 'jpeg']),
    desktop: await sources(site.shots.desktop, desktop, ['avif', 'webp']),
    img: await getImage({ src: site.shots.desktop, format: 'jpeg', width: 1200, ...desktop }),
})));
---
<!-- Hero -->
<section id="home">
    <div class="scrub-wrap" id="scrub-wrap">
        <div class="scrub-stage" id="scrub-stage">
            <div class="deck-glow" aria-hidden="true"></div>
            <div class="wheel" id="wheel">
                <div class="wheel-labels">
                    {sites.map((site, i) => (
                        <div class="wheel-label" data-i={i}>
                            <div class="eyebrow" set:html={text(site.category)} />
                            <h2 set:html={text(site.name)} />
                            <p set:html={text(site.wheel.blurb)} />
                        </div>
                    ))}
                </div>
                <div class="wheel-ring" id="wheel-ring" aria-hidden="true"></div>
                <div class="wheel-dots" id="wheel-dots" aria-hidden="true">{sites.map(() => <i></i>)}</div>
                <div class="wheel-cards">
                    {sites.map((site, i) => (
                        <figure class="wheel-card" data-i={i}>
                            {site.wheel.link
                                ? <a class="card-link" href={site.wheel.link.href} aria-label={site.wheel.link.label}><span set:html={text(site.wheel.link.text)} /></a>
                                : <a class="card-link" href={site.url} target="_blank" rel="noopener" aria-label={`Visit ${site.name}`}><span>Visit site</span></a>}
                            <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span set:html={text(site.wheel.bar)} /></div>
                            <div class="shot">
                                <picture>
                                    {shots[i].mobile.map((s) => <source media={MOBILE} type={s.type} srcset={s.srcset} sizes={mobile.sizes} width={site.shots.mobile.width} height={site.shots.mobile.height}>)}
                                    {shots[i].desktop.map((s) => <source type={s.type} srcset={s.srcset} sizes={desktop.sizes}>)}
                                    <img src={shots[i].img.src} srcset={shots[i].img.srcSet.attribute} sizes={desktop.sizes} width={site.shots.desktop.width} height={site.shots.desktop.height} alt={site.wheel.alt} decoding="async" fetchpriority={i === 0 ? 'high' : undefined}>
                                </picture>
                            </div>
                        </figure>
                    ))}
                </div>
            </div>
            <div class="sband sband-giant" data-band="0.03,0.12" data-entrance="words">
                <h2 class="sb-line sb-giant" data-split>Most websites are forgettable.</h2>
            </div>
            <div class="sband sband-giant" data-band="0.13,0.22" data-entrance="words">
                <h2 class="sb-line sb-giant sb-gold" data-split>Yours won't be.</h2>
            </div>
            <div class="sband sband-settle" data-band="0.92,1">
                <h1 class="settle-name">PERKINS<br>PRODUCTION</h1>
                <p class="settle-sub">Websites that move &middot; Frederick, MD</p>
                <a class="settle-cta" href="#contact">Start your project</a>
            </div>
            <div class="scrub-cue" id="scrub-cue">Scroll</div>
        </div>
    </div>
    <div class="classic-hero">
    <div id="hero-reel" aria-hidden="true"></div>
    <div id="hero-veil" aria-hidden="true"></div>
    <div id="hero-particles"></div>
    <div class="hero-content">
        <Logo id="gGhero" class="hero-logo" centered />
        <p class="hero-tagline">Websites that move</p>
        <p class="hero-services">Web Design &middot; Photo &middot; Video &middot; 3D/VR</p>
        <a href="#contact" class="hero-cta">Start your project</a>
    </div>
    <div class="scroll-indicator"><span></span></div>
    </div>
</section>
