<script is:inline>

    // ===== SCROLL PROGRESS BAR =====
    const scrollProgress = document.getElementById('scroll-progress');
    window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrollPercent = (scrollTop / docHeight) * 100;
        scrollProgress.style.width = scrollPercent + '%';
    });

    // ===== SCROLL NAV =====
    window.addEventListener('scroll', () => {
        const nav = document.getElementById('navbar');
        nav.classList.toggle('scrolled', window.scrollY > 50);

        const sections = document.querySelectorAll('section');
        const navLinks = document.querySelectorAll('.nav-links a:not(.book-btn)');
        const creativeToggle = document.querySelector('.nav-dropdown-toggle');
        let current = '';
        sections.forEach(s => {
            if (s.offsetParent === null) return; // collapsed sections do not count
            if (window.scrollY >= s.offsetTop - 120) current = s.id;
        });
        navLinks.forEach(link => {
            link.classList.toggle('active', link.getAttribute('href') === '#' + current);
        });
        if (creativeToggle) creativeToggle.classList.toggle('active', current === 'matterport' || current === 'webdesign');
    });

    // ===== MOBILE MENU =====
    function toggleMenu() {
        const links = document.getElementById('nav-links');
        const button = document.getElementById('hamburger');
        const open = links.classList.toggle('open');
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    }
    const creativeNav = document.getElementById('creativeNav');
    const creativeToggle = creativeNav ? creativeNav.querySelector('.nav-dropdown-toggle') : null;
    function setCreativeMenu(open) {
        if (!creativeNav || !creativeToggle) return;
        creativeNav.classList.toggle('open', open);
        creativeToggle.setAttribute('aria-expanded', String(open));
    }
    if (creativeToggle) creativeToggle.addEventListener('click', e => {
        e.stopPropagation();
        setCreativeMenu(!creativeNav.classList.contains('open'));
    });
    // ===== SMOOTH ANCHOR SCROLL (bounded; CSS smooth scrolling fights the scrub hero) =====
    document.addEventListener('click', function (e) {
        const link = e.target.closest('a[href^="#"]');
        if (!link) return;
        const id = link.getAttribute('href');
        if (!id || id === '#') return;
        const dest = document.querySelector(id);
        if (!dest) return;
        e.preventDefault();
        if (dest.closest('#photo-video-group') && window.revealPhotoVideo) window.revealPhotoVideo();
        animateScrollTo(dest, id);
    });
    function animateScrollTo(dest, id) {
        const startY = window.scrollY;
        const endY = Math.round(dest.getBoundingClientRect().top + window.scrollY);
        const dist = endY - startY;
        if (!dist) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
            window.scrollTo(0, endY);
            if (id) history.replaceState(null, '', id);
            return;
        }
        const dur = Math.min(700, Math.max(320, Math.abs(dist) * 0.28));
        const t0 = performance.now();
        (function step(now) {
            const p = Math.min(1, (now - t0) / dur);
            const eased = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
            window.scrollTo(0, Math.round(startY + dist * eased));
            if (p < 1) requestAnimationFrame(step);
            else if (id) history.replaceState(null, '', id);
        })(t0);
    }

    // ===== PHOTO & VIDEO REVEAL =====
    (function () {
        const btn = document.getElementById('reveal-photo');
        const group = document.getElementById('photo-video-group');
        if (!btn || !group) return;
        function setOpen(open, scroll) {
            group.hidden = !open;
            btn.setAttribute('aria-expanded', String(open));
            btn.textContent = open ? 'Hide the photo, video, and 3D work' : 'See the photo, video, and 3D work';
            if (open && scroll) requestAnimationFrame(() => animateScrollTo(group, null));
        }
        btn.addEventListener('click', () => setOpen(group.hidden, group.hidden));
        window.revealPhotoVideo = function () { if (group.hidden) setOpen(true, false); };
        function openForHash() {
            const m = /^#(weddings|films|portraits|matterport)$/.exec(location.hash);
            if (!m) return;
            setOpen(true, false);
            const target = document.getElementById(m[1]);
            if (target) requestAnimationFrame(() => target.scrollIntoView());
        }
        openForHash();
        window.addEventListener('hashchange', openForHash);
    })();

    document.querySelectorAll('.nav-links a').forEach(link => {
        link.addEventListener('click', () => {
            document.getElementById('nav-links').classList.remove('open');
            document.getElementById('hamburger').setAttribute('aria-expanded', 'false');
            setCreativeMenu(false);
        });
    });
    document.addEventListener('click', e => {
        if (creativeNav && !creativeNav.contains(e.target)) setCreativeMenu(false);
    });
    window.addEventListener('keydown', e => {
        if (e.key === 'Escape') setCreativeMenu(false);
    });

    // ===== FLOATING BOKEH PARTICLES =====
    (function createParticles() {
        const container = document.getElementById('hero-particles');
        if (!container) return;
        for (let i = 0; i < 20; i++) {
            const particle = document.createElement('div');
            particle.className = 'particle';
            const size = Math.random() * 6 + 2;
            particle.style.cssText = `
                position: absolute;
                width: ${size}px;
                height: ${size}px;
                background: radial-gradient(circle, rgba(201,169,110,${Math.random() * 0.3 + 0.1}), transparent);
                border-radius: 50%;
                left: ${Math.random() * 100}%;
                top: ${Math.random() * 100}%;
                animation: floatParticle ${Math.random() * 10 + 8}s ease-in-out infinite;
                animation-delay: ${Math.random() * -15}s;
                pointer-events: none;
            `;
            container.appendChild(particle);
        }
    })();

    // ===== INTERSECTION OBSERVER FOR ALL ANIMATIONS =====
    const animObserver = new IntersectionObserver(entries => {
        entries.forEach(e => {
            if (e.isIntersecting) {
                e.target.classList.add('visible');
            }
        });
    }, { threshold: 0.1 });

    // Observe all animated elements
    document.querySelectorAll('.fade-in, .fade-in-left, .fade-in-right, .scale-in, .section-header').forEach(el => {
        animObserver.observe(el);
    });

    // ===== PRICING TABS =====
    (function () {
        const tabs = document.querySelectorAll('.pricing-tab');
        const grid = document.querySelector('.pricing-grid');
        if (!tabs.length || !grid) return;
        const cards = grid.querySelectorAll('.pricing-card');
        function show(group) {
            tabs.forEach(t => {
                const on = t.dataset.group === group;
                t.classList.toggle('active', on);
                t.setAttribute('aria-selected', String(on));
            });
            let n = 0;
            cards.forEach(c => {
                const on = (c.dataset.group || '').split(' ').includes(group);
                c.hidden = !on;
                if (on) { c.style.transitionDelay = (n * 0.08) + 's'; c.classList.add('visible'); n++; }
            });
            grid.classList.toggle('cols-2', n === 2);
            grid.classList.toggle('cols-4', n === 4);
        }
        tabs.forEach(t => t.addEventListener('click', () => show(t.dataset.group)));
        show('web');
    })();

    // ===== STAGGERED GRID ITEM ANIMATIONS =====
    document.querySelectorAll('.photo-grid, .portrait-grid, .pricing-grid, .matterport-grid').forEach(grid => {
        const items = grid.children;
        Array.from(items).forEach((item, index) => {
            item.style.transitionDelay = (index * 0.1) + 's';
        });
    });

    // ===== BUTTON RIPPLE EFFECT =====
    document.querySelectorAll('.hero-cta, .pricing-cta, .cta-button, .book-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
            const rect = this.getBoundingClientRect();
            const ripple = document.createElement('span');
            ripple.style.cssText = `
                position: absolute;
                border-radius: 50%;
                background: rgba(255,255,255,0.4);
                width: 0; height: 0;
                left: ${e.clientX - rect.left}px;
                top: ${e.clientY - rect.top}px;
                transform: translate(-50%, -50%);
                animation: rippleEffect 0.6s ease-out forwards;
                pointer-events: none;
            `;
            this.style.position = 'relative';
            this.style.overflow = 'hidden';
            this.appendChild(ripple);
            setTimeout(() => ripple.remove(), 700);
        });
    });

    // ===== SUBTLE PARALLAX ON HERO =====
    window.addEventListener('scroll', () => {
        const hero = document.getElementById('home');
        if (!hero) return;
        const scrolled = window.scrollY;
        if (scrolled < window.innerHeight) {
            const heroContent = hero.querySelector('.hero-content');
            if (heroContent) {
                heroContent.style.transform = `translateY(${scrolled * 0.15}px)`;
                heroContent.style.opacity = 1 - (scrolled / (window.innerHeight * 0.8));
            }
        }
    });

    // ===== LIGHTBOX =====
    function openLightbox(src) {
        document.getElementById('lightbox-img').src = src;
        const lightbox = document.getElementById('lightbox');
        lightbox.classList.add('active');
        lightbox.setAttribute('aria-hidden', 'false');
        lightbox.querySelector('.lightbox-close').focus();
    }
    function closeLightbox() {
        const lightbox = document.getElementById('lightbox');
        lightbox.classList.remove('active');
        lightbox.setAttribute('aria-hidden', 'true');
        document.getElementById('lightbox-img').src = '';
    }
    window.addEventListener('keydown', event => {
        if (event.key === 'Escape' && document.getElementById('lightbox').classList.contains('active')) closeLightbox();
    });

    // ===== FORMS =====
    async function handleContact(e) {
        e.preventDefault();
        const form = e.target;
        const btn = form.querySelector('button[type="submit"]');
        const status = document.getElementById('contact-status');
        status.className = 'form-status';
        btn.disabled = true;
        btn.textContent = 'Sending...';
        try {
            const data = Object.fromEntries(new FormData(form).entries());
            data._subject = 'New inquiry from perkinsproduction.com';
            data._template = 'table';
            data._autoresponse = "Hey! Thanks so much for reaching out. Your message just landed in my inbox and I'll get back to you personally within 24 hours, usually much sooner. If it's time-sensitive, you can reach me directly at (240) 818-1955. Talk soon! - Brice Perkins, Perkins Production, www.perkinsproduction.com";
            const resp = await fetch('https://formsubmit.co/ajax/a7d5b78e00f421cfd90149fcc07ffbf8', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify(data)
            });
            if (!resp.ok) throw new Error('Send failed');
            form.reset();
            btn.textContent = 'Send Message';
            btn.disabled = false;
            status.textContent = 'Thank you! Your message is on its way. I\'ll be in touch soon.';
            status.classList.add('show', 'success');
        } catch (err) {
            btn.textContent = 'Send Message';
            btn.disabled = false;
            status.textContent = 'Something went wrong. Please email brice@perkinsproduction.com directly.';
            status.classList.add('show', 'error');
        }
    }

    // ===== WEDDING FILMS CLICK-TO-PLAY =====
    document.querySelectorAll('.film-card').forEach(card => {
        card.addEventListener('click', () => {
            if (card.classList.contains('playing')) return;
            const id = card.dataset.video;
            const title = card.dataset.title || 'Wedding film';
            card.classList.add('playing');
            card.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0" title="${title}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
        });
    });

    // ===== SCROLL DECK HERO =====
    (function () {
        var wrap = document.getElementById('scrub-wrap');
        if (!wrap) return;
        var cue = document.getElementById('scrub-cue');
        var wheel = document.getElementById('wheel');
        var wheelRing = document.getElementById('wheel-ring');
        var stage = document.getElementById('scrub-stage');

        // Split the words-entrance line once, with seeded thresholds
        document.querySelectorAll('.sb-line[data-split]').forEach(function (line) {
            var words = line.textContent.trim().split(/\s+/);
            var full = document.createElement('span');
            full.className = 'sr-only';
            full.style.cssText = 'position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)';
            full.textContent = words.join(' ');
            var sd = 1863;
            var rng = function () { sd = (sd * 1664525 + 1013904223) >>> 0; return sd / 4294967296; };
            line.textContent = '';
            line.appendChild(full);
            var vis = document.createElement('span');
            vis.setAttribute('aria-hidden', 'true');
            words.forEach(function (word, i) {
                var w = document.createElement('span');
                w.className = 'w';
                w.textContent = word;
                w.style.setProperty('--th', (i / words.length * 0.4 + rng() * 0.08).toFixed(3));
                vis.appendChild(w);
                if (i < words.length - 1) vis.appendChild(document.createTextNode(' '));
            });
            line.appendChild(vis);
        });

        var bands = [].map.call(document.querySelectorAll('.sband'), function (el, i) {
            var r = el.getAttribute('data-band').split(',');
            return { el: el, a: parseFloat(r[0]), b: parseFloat(r[1]), first: i === 0, last: false, op: -1, k: -1 };
        });
        bands[bands.length - 1].last = true;

        var cards = [].map.call(document.querySelectorAll('.wheel-card'), function (el, i) {
            return { el: el, img: el.querySelector('img'), shot: el.querySelector('.shot'),
                     label: document.querySelector('.wheel-label[data-i="' + i + '"]'),
                     tf: null, op: null, pan: null, lop: null };
        });

        var smoothstep = function (p, e0, e1) {
            var t = Math.min(1, Math.max(0, (p - e0) / (e1 - e0)));
            return t * t * (3 - 2 * t);
        };

        var loadK = 0;
        function heroProgress() {
            var range = wrap.offsetHeight - innerHeight;
            if (range <= 0) return 0;
            return Math.min(1, Math.max(0, (scrollY - wrap.offsetTop) / range));
        }
        var cueOn = true;
        function updateCaptions(p) {
            bands.forEach(function (band) {
                var f = Math.min(0.02, (band.b - band.a) / 3);
                var op = (band.first ? (p < band.b ? 1 : 0) * (1 - smoothstep(p, band.b - f, band.b))
                                     : smoothstep(p, band.a, band.a + f) * (band.last ? 1 : 1 - smoothstep(p, band.b - f, band.b)));
                var ramp = Math.min(0.025, (band.b - band.a) * 0.35);
                var k = Math.min(1, Math.max(0, (p - band.a) / ramp));
                if (band.first) k = Math.max(k, loadK, p > 0 ? 1 : 0);
                if (Math.abs(op - band.op) > 0.008) { band.op = op; band.el.style.opacity = op.toFixed(3); band.el.classList.toggle('live', op > 0.5); }
                if (Math.abs(k - band.k) > 0.008) { band.k = k; band.el.style.setProperty('--k', k.toFixed(3)); }
            });
            var wantCue = p < 0.02;
            if (wantCue !== cueOn) { cueOn = wantCue; cue.style.setProperty('--cue', wantCue ? 1 : 0); }
        }

        // The wheel: hub below the stage, cards ride the rim, one turn per site with a dwell to read
        var WA = 0.22, WB = 0.84, geo = null, wheelOp = null, wheelRise = null, dotOn = -1;
        var dots = [].slice.call(document.querySelectorAll('#wheel-dots i'));
        function wheelGeo() {
            if (geo) return geo;
            var H = stage.clientHeight, W = stage.clientWidth;
            var mobile = W < 720 || W < H;
            geo = { R: (mobile ? 0.50 : 0.85) * H, D: mobile ? 27 : 40, top: 0.60 * H };
            wheelRing.style.width = wheelRing.style.height = (2 * geo.R).toFixed(0) + 'px';
            wheelRing.style.top = geo.top.toFixed(0) + 'px';
            return geo;
        }
        function renderWheel(p) {
            var g = wheelGeo();
            var u = Math.min(3, Math.max(0, (p - WA) / (WB - WA) * 3));
            var k = Math.min(2, Math.floor(u)), fr = u - k;
            var omega = g.D * (k + smoothstep(fr, 0.35, 0.85));
            var rise = smoothstep(p, 0.12, 0.21), out = 1 - smoothstep(p, 0.92, 0.965);
            var vis = smoothstep(p, 0.22, 0.25) * out;
            if (wheelOp === null || Math.abs(vis - wheelOp) > 0.006 || Math.abs(rise - wheelRise) > 0.004) {
                wheelOp = vis; wheelRise = rise;
                wheel.style.opacity = ((0.35 + 0.65 * rise) * out).toFixed(3);
                wheel.style.transform = 'translateY(' + ((1 - rise) * 22).toFixed(2) + 'vh)';
            }
            var on = Math.round(u);
            if (on !== dotOn) { dotOn = on; dots.forEach(function (d, i) { d.classList.toggle('on', i === on); }); }
            for (var i = 0; i < cards.length; i++) {
                var c = cards[i];
                var a = i * g.D - omega, rad = a * Math.PI / 180;
                var x = g.R * Math.sin(rad), y = g.R * (1 - Math.cos(rad));
                var ca = Math.max(0, Math.cos(rad));
                var sc = 0.5 + 0.5 * ca * ca;
                var op = Math.min(1, Math.max(0, (ca - 0.2) / 0.8));
                var tf = 'translate(-50%,-50%) translate(' + x.toFixed(1) + 'px,' + y.toFixed(1) + 'px) scale(' + sc.toFixed(3) + ')';
                if (tf !== c.tf) { c.tf = tf; c.el.style.transform = tf; c.el.style.zIndex = String(100 - Math.round(Math.abs(a))); c.el.style.pointerEvents = Math.abs(a) < g.D * 0.5 ? 'auto' : 'none'; }
                if (c.op === null || Math.abs(op - c.op) > 0.006) { c.op = op; c.el.style.opacity = op.toFixed(3); }
                var q = Math.min(1, Math.max(0, (u - i + 0.15) / 0.85));
                var pan = -q * 0.55 * Math.max(0, c.img.clientHeight - c.shot.clientHeight);
                if (c.pan === null || Math.abs(pan - c.pan) > 0.5) { c.pan = pan; c.img.style.transform = 'translateY(' + pan.toFixed(1) + 'px)'; }
                var lop = Math.max(0, 1 - Math.abs(a) / (g.D * 0.5)) * vis;
                if (c.lop === null || Math.abs(lop - c.lop) > 0.008) {
                    c.lop = lop;
                    c.label.style.opacity = lop.toFixed(3);
                    c.label.style.setProperty('--lty', ((1 - lop) * 16).toFixed(1) + 'px');
                }
            }
        }
        function render(p) { renderWheel(p); updateCaptions(p); }

        // Lerp loop that rests, leashed to the real scroll position
        var target = 0, shown = 0, rafId = null, lastTick = 0, heroOnScreen = true;
        function tick(now) {
            var dt = Math.min(100, now - (lastTick || now));
            lastTick = now;
            shown += (target - shown) * (1 - Math.pow(1 - 0.28, dt / 16.667));
            if (shown < target - 0.04) shown = target - 0.04;
            else if (shown > target + 0.04) shown = target + 0.04;
            if (Math.abs(target - shown) < 0.0005) { shown = target; rafId = null; lastTick = 0; }
            else { rafId = requestAnimationFrame(tick); }
            render(shown);
        }
        function onScroll() {
            target = heroProgress();
            if (rafId === null && heroOnScreen) rafId = requestAnimationFrame(tick);
        }
        addEventListener('resize', function () { geo = null; cards.forEach(function (c) { c.tf = null; c.pan = null; }); render(shown); onScroll(); }, { passive: true });

        new IntersectionObserver(function (entries) {
            heroOnScreen = entries[0].isIntersecting;
            if (!heroOnScreen) {
                if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; lastTick = 0; }
                shown = target;
            } else {
                onScroll();
            }
        }).observe(wrap);

        var inited = false;
        function initHeroOnce() {
            if (inited) return;
            inited = true;
            var t0 = performance.now();
            (function rampLoad(now) {
                loadK = Math.min(1, (now - t0) / 1600);
                updateCaptions(shown);
                if (loadK < 1) requestAnimationFrame(rampLoad);
            })(t0);
        }

        // The one gate, character-identical to the CSS
        var GATES = ['(prefers-reduced-motion: reduce)'];
        var scrubOn = false;
        function enableScrub() {
            if (scrubOn) return; scrubOn = true;
            document.body.classList.add('scrub-mode');
            initHeroOnce();
            addEventListener('scroll', onScroll, { passive: true });
            bands.forEach(function (b) { b.op = -1; b.k = -1; });
            geo = null; wheelOp = null; wheelRise = null; cards.forEach(function (c) { c.tf = null; c.op = null; c.pan = null; c.lop = null; });
            target = shown = heroProgress();
            render(shown);
        }
        function disableScrub() {
            if (!scrubOn) return; scrubOn = false;
            document.body.classList.remove('scrub-mode');
            removeEventListener('scroll', onScroll);
            if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
            if (window.maybeInitReel) window.maybeInitReel();
        }
        function applyHeroMode() {
            if (GATES.some(function (q) { return matchMedia(q).matches; })) disableScrub();
            else enableScrub();
        }
        window.__applyHeroMode = applyHeroMode;
        GATES.map(function (q) { return matchMedia(q); }).forEach(function (m) { m.addEventListener('change', applyHeroMode); });
        applyHeroMode();
    })();

    // ===== CINEMATIC HERO REEL (classic hero; phones, portrait, reduced motion) =====
    window.__reelPayload = null;
    window.maybeInitReel = function () {
        if (document.body.classList.contains('scrub-mode')) return;
        if (window.__reelPayload) initHeroReel(window.__reelPayload[0], window.__reelPayload[1]);
    };
    function initHeroReel(images, positions) {
        const reel = document.getElementById('hero-reel');
        if (!reel || reel.dataset.inited) return;
        reel.dataset.inited = '1';
        const order = [
            { slot: 'wedding-featured', video: '/reel/wedding-featured.mp4' },
            { slot: 'wedding-details', video: '/reel/wedding-details.mp4' },
            { slot: 'wedding-firstdance', video: '/reel/wedding-firstdance.mp4' },
            { slot: 'portrait-engagement', video: '/reel/portrait-engagement.mp4' },
            { slot: 'portrait-senior', video: '/reel/portrait-senior.mp4' },
            { slot: 'portrait-creative', video: '/reel/portrait-creative.mp4' },
            { slot: 'wedding-ceremony', video: '/reel/wedding-ceremony.mp4' },
            { slot: 'wedding-reception', video: '/reel/wedding-reception.mp4' }
        ];
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const viewWidth = Math.max(window.innerWidth || 0, document.documentElement.clientWidth || 0, (window.screen && screen.width) || 0);
        const wideScreen = viewWidth >= 700;
        const saveData = navigator.connection && navigator.connection.saveData;
        const useVideo = !reduced && wideScreen && !saveData;

        const entries = order
            .filter(e => images[e.slot])
            .map(e => ({ url: images[e.slot], pos: positions[e.slot], video: useVideo ? e.video : null }));
        if (entries.length < 2) return;

        const drifts = ['reel-kb-a', 'reel-kb-b', 'reel-kb-c', 'reel-kb-d'];
        const slides = entries.map((entry, i) => {
            const slide = document.createElement('div');
            const drift = drifts[i % drifts.length];
            slide.className = 'reel-slide' + (entry.video ? '' : ' ' + drift);
            slide.style.backgroundImage = `url("${entry.url}")`;
            if (entry.pos) {
                slide.style.backgroundPosition = `${entry.pos.x}% ${entry.pos.y}%`;
            }
            if (entry.video) {
                const v = document.createElement('video');
                v.muted = true;
                v.playsInline = true;
                v.setAttribute('playsinline', '');
                v.preload = 'none';
                v.src = entry.video;
                if (entry.pos) v.style.objectPosition = `${entry.pos.x}% ${entry.pos.y}%`;
                v.addEventListener('error', () => {
                    v.remove();
                    entry.el = null;
                    slide.classList.add(drift);
                });
                slide.appendChild(v);
                entry.el = v;
            }
            reel.appendChild(slide);
            return slide;
        });

        let current = 0;
        const playVideo = i => {
            const v = entries[i].el;
            if (!v) return;
            try { v.currentTime = 0; } catch (e) {}
            v.playbackRate = 0.85;
            v.play().catch(() => {});
        };
        const show = next => {
            const prev = slides[current];
            const prevVideo = entries[current].el;
            const incoming = slides[next];
            slides.forEach(s => { s.style.zIndex = 1; });
            incoming.style.zIndex = 2;
            incoming.classList.add('active');
            playVideo(next);
            if (incoming !== prev) {
                setTimeout(() => {
                    prev.classList.remove('active');
                    if (prevVideo) prevVideo.pause();
                }, 3600);
            }
            current = next;
        };
        const preload = i => {
            const entry = entries[i % entries.length];
            if (entry.el) { entry.el.preload = 'auto'; entry.el.load(); }
            else { const img = new Image(); img.src = entry.url; }
        };

        // Video slides begin their crossfade while the clip is still moving,
        // so motion hands off to motion and the end-freeze stays hidden.
        const VIDEO_HOLD = 5500;
        const PHOTO_HOLD = 8000;
        const queueNext = () => {
            const hold = entries[current].el ? VIDEO_HOLD : PHOTO_HOLD;
            setTimeout(() => {
                show((current + 1) % slides.length);
                preload(current + 1);
                queueNext();
            }, hold);
        };

        const first = new Image();
        first.onload = () => {
            show(0);
            preload(1);
            if (reduced) return;
            queueNext();
        };
        first.src = entries[0].url;
    }

    // ===== LOAD PHOTOS FROM STORAGE =====
    (async function loadPhotos() {
        try {
            const resp = await fetch('/api/images');
            if (!resp.ok) return;
            const data = await resp.json();
            if (!data.images) return;
            const positions = data.positions || {};
            window.__reelPayload = [data.images, positions];
            window.maybeInitReel();

            document.querySelectorAll('[data-slot]').forEach(item => {
                const slot = item.dataset.slot;
                const url = data.images[slot];
                if (!url) return;

                // Replace placeholder with real image
                const placeholder = item.querySelector('.photo-placeholder');
                if (placeholder) {
                    const img = document.createElement('img');
                    img.src = url;
                    img.alt = slot.replace(/-/g, ' ');
                    img.loading = 'lazy';
                    const pos = positions[slot];
                    let style = 'width:100%;height:100%;object-fit:cover;position:absolute;top:0;left:0;';
                    if (pos) {
                        style += `object-position:${pos.x}% ${pos.y}%;`;
                        if (pos.scale && pos.scale !== 1) {
                            style += `transform:scale(${pos.scale});transform-origin:${pos.x}% ${pos.y}%;`;
                        }
                    }
                    img.style.cssText = style;
                    placeholder.style.display = 'none';
                    item.classList.add('has-image');
                    item.insertBefore(img, placeholder);

                    // Make overlay clickable for lightbox
                    const overlay = item.querySelector('.overlay');
                    if (overlay) {
                        overlay.disabled = false;
                        overlay.addEventListener('click', () => openLightbox(url));
                    }
                }
            });
        } catch (e) {
            // Silently fail; placeholders remain visible
        }
    })();
</script>

    <div class="cursor-glow" aria-hidden="true"></div>
    <script is:inline>
    // ===== MOAT LINES: each slides up out of its own line as it scrolls into view =====
    (function () {
        var lines = document.querySelectorAll('.moat-l');
        if (!lines.length) return;
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) return;   // text simply stays visible
        document.documentElement.classList.add('moat-js');
        var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
                if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
            });
        }, { rootMargin: '0px 0px -18% 0px', threshold: 0.4 });
        lines.forEach(function (l) { io.observe(l); });
    })();

    // ===== STAT STRIP: numerals count up once when they come into view =====
    (function () {
        var nums = document.querySelectorAll('.stat-n[data-count]');
        if (!nums.length || !('IntersectionObserver' in window)) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;   // real numbers already in the HTML
        function run(el) {
            var n = parseInt(el.getAttribute('data-count'), 10);
            if (!n) { el.textContent = '0'; return; }
            var t0 = performance.now(), dur = 1400;
            (function step(now) {
                var p = Math.min(1, (now - t0) / dur), e = 1 - Math.pow(1 - p, 3);
                el.textContent = Math.round(n * e);
                if (p < 1) requestAnimationFrame(step);
            })(t0);
        }
        var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
                if (en.isIntersecting) { run(en.target); io.unobserve(en.target); }
            });
        }, { threshold: 0.6 });
        nums.forEach(function (el) { if (el.getAttribute('data-count') !== '0') el.textContent = '0'; io.observe(el); });
    })();

    // ===== CURSOR GLOW: eased follow, desktop pointers only, rests when still =====
    (function () {
        var g = document.querySelector('.cursor-glow');
        if (!g) return;
        if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var tx = 0, ty = 0, x = 0, y = 0, raf = null, last = 0;
        function tick(now) {
            var dt = Math.min(64, now - (last || now)); last = now;
            var k = 1 - Math.pow(1 - 0.18, dt / 16.667);
            x += (tx - x) * k; y += (ty - y) * k;
            g.style.transform = 'translate3d(' + x.toFixed(1) + 'px,' + y.toFixed(1) + 'px,0)';
            if (Math.abs(tx - x) + Math.abs(ty - y) > 0.4) raf = requestAnimationFrame(tick);
            else { raf = null; last = 0; }
        }
        addEventListener('pointermove', function (e) {
            tx = e.clientX; ty = e.clientY;
            if (!g.classList.contains('on')) { x = tx; y = ty; g.classList.add('on'); }
            if (raf === null) raf = requestAnimationFrame(tick);
        }, { passive: true });
        addEventListener('mouseout', function (e) { if (!e.relatedTarget) g.classList.remove('on'); });
    })();
    </script>
