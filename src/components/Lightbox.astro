<!-- Lightbox -->
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo preview" aria-hidden="true" onclick="closeLightbox()">
    <button type="button" class="lightbox-close" aria-label="Close photo preview" onclick="event.stopPropagation();closeLightbox()">&times;</button>
    <img src="" alt="" id="lightbox-img">
</div>
