---
// The numbers are typed into the HTML so they read right without JS;
// the count-up script animates from data-count.
const stats = [
    { n: 4, label: 'Sites live' },
    { n: 0, label: 'Templates' },
    { n: 1, label: 'Person, start to finish' },
    { n: 63, label: 'Years of JFK 50 results' },
];
---
<!-- By the numbers -->
<div class="stat-strip" aria-label="Perkins Production by the numbers">
    {stats.map((s) => (
        <div class="stat"><div class="stat-n" data-count={s.n}>{s.n}</div><div class="stat-l">{s.label}</div></div>
    ))}
</div>
