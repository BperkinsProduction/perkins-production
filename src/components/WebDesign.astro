---
import WorkGrid from './webdesign/WorkGrid.astro';
import StatStrip from './webdesign/StatStrip.astro';
import WhatYouGet from './webdesign/WhatYouGet.astro';
import Moat from './webdesign/Moat.astro';
import Process from './webdesign/Process.astro';
---
<!-- Work -->
<section id="webdesign">
    <div class="section-header fade-in">
        <h2>Work</h2>
        <div class="divider"></div>
        <p>Websites I've built, including the one you're on</p>
    </div>
    <div class="webdesign-intro fade-in">
        <p>Hand-coded websites for businesses that want to be remembered. Everything here was designed, built, hosted, and photographed by one person, so nothing looks like a template and nothing looks like stock.</p>
    </div>

    <WorkGrid />

    <StatStrip />

    <WhatYouGet />

    <Moat />

    <Process />

    <div class="section-cta fade-in" style="margin-top: 3rem;">
        <a href="#contact">Start Your Project</a>
    </div>
</section>
