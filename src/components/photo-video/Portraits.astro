            </div>
            <button type="button" class="overlay" aria-label="View headshot" disabled><span>View</span></button>
        </div>
        <div class="photo-item fade-in" data-slot="portrait-senior">
            <div class="photo-placeholder">
                <svg viewBox="0 0 24 24" class="icon-camera"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Senior
