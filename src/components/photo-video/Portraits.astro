---
import PhotoSlot from './PhotoSlot.astro';
---
<!-- Portraits -->
<section id="portraits">
    <div class="section-header fade-in">
        <h2>Portraits</h2>
        <div class="divider"></div>
        <p>Revealing the authentic you, one frame at a time</p>
    </div>
    <div class="category-intro fade-in">
        <p>Whether you need a professional headshot, senior portraits, family photos, or something creative, I work to make you feel comfortable and confident in front of the lens. The result: images that truly reflect who you are.</p>
    </div>
    <div class="photo-grid portrait-grid">
        <PhotoSlot name="portrait-portrait" label="Portrait" view="View portrait photo" icon="person" />
        <PhotoSlot name="portrait-headshot" label="Headshot" view="View headshot" icon="person" />
        <PhotoSlot name="portrait-senior" label="Senior" view="View senior portrait" icon="person" />
        <PhotoSlot name="portrait-family" label="Family" view="View family portrait" icon="person" />
        <PhotoSlot name="portrait-creative" label="Creative" view="View creative portrait" icon="person" />
        <PhotoSlot name="portrait-engagement" label="Engagement" view="View engagement portrait" icon="person" />
    </div>
    <div class="section-cta fade-in">
        <a href="#contact">Book a Portrait Session</a>
    </div>
</section>
