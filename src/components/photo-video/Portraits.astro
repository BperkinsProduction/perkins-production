<!-- Portraits -->
<section id="portraits">
    <div class="section-header fade-in">
        <h2>Portraits</h2>
        <div class="divider"></div>
        <p>Revealing the authentic you, one frame at a time</p>
    </div>
    <div class="category-intro fade-in">
        <p>Whether you need a professional headshot, senior portraits, family photos, or something creative, I work to make you feel comfortable and confident in front of the lens. The result: images that truly reflect who you are.</p>
    </div>
    <div class="photo-grid portrait-grid">
        <div class="photo-item fade-in" data-slot="portrait-portrait">
            <div class="photo-placeholder">
                <svg viewBox="0 0 24 24" class="icon-camera"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Portrait
            </div>
            <button type="button" class="overlay" aria-label="View portrait photo" disabled><span>View</span></button>
        </div>
        <div class="photo-item fade-in" data-slot="portrait-headshot">
            <div class="photo-placeholder">
                <svg viewBox="0 0 24 24" class="icon-camera"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
