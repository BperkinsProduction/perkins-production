---
import { text } from '../../utils/text';

// YouTube wedding films. id is the video id; the thumbnail falls back to hqdefault.
const films = [
    { id: 'qoaBE6s6E4Y', title: "Gavin & Hannah's Wedding", label: 'Gavin & Hannah', play: "Play Gavin and Hannah's wedding film", alt: "Gavin and Hannah's wedding film", featured: true },
    { id: 'Vf3AfBJzols', title: "Rachel and Nick's Wedding", label: 'Rachel & Nick', play: "Play Rachel and Nick's wedding film", alt: "Rachel and Nick's wedding film" },
    { id: 'PIYtgQfURm8', title: "Ellie and Anthony's Wedding", label: 'Ellie & Anthony', play: "Play Ellie and Anthony's wedding film", alt: "Ellie and Anthony's wedding film" },
    { id: 'Eb68OC_WZYk', title: "Brad and Sheridan's Wedding", label: 'Brad & Sheridan', play: "Play Brad and Sheridan's wedding film", alt: "Brad and Sheridan's wedding film" },
    { id: 'otaNsam8Rfk', title: "The Silers' Wedding", label: 'The Silers', play: "Play the Silers' wedding film", alt: "The Silers' wedding film" },
    { id: 'SSsBfJJMqBY', title: "Amy and Philip's Wedding", label: 'Amy & Philip', play: "Play Amy and Philip's wedding film", alt: "Amy and Philip's wedding film" },
];
---
<!-- Wedding Films -->
<section id="films">
    <div class="section-header fade-in">
        <h2>Wedding Films</h2>
        <div class="divider"></div>
        <p>Cinematic films that let you relive your day, again and again</p>
    </div>
    <div class="films-grid">
        {films.map((film) => (
            <button type="button" class:list={['film-card', { 'film-featured': film.featured }, 'fade-in']} data-video={film.id} data-title={film.title} aria-label={film.play}>
                <img src={`https://i.ytimg.com/vi/${film.id}/maxresdefault.jpg`} alt={film.alt} loading="lazy" onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${film.id}/hqdefault.jpg';`}>
                <div class="film-play"><span></span></div>
                <div class="film-label" set:html={text(film.label)} />
            </button>
        ))}
    </div>
    <div class="section-cta fade-in">
        <a href="https://www.youtube.com/playlist?list=PLakjd2_HLDVC2DOt3MXClHkBFu7ltNfsW" target="_blank" rel="noopener">Watch All on YouTube</a>
    </div>
</section>
