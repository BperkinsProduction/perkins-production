---
import PhotoSlot from './PhotoSlot.astro';
---
<!-- Weddings -->
<section id="weddings">
    <div class="section-header fade-in">
        <h2>Weddings</h2>
        <div class="divider"></div>
        <p>Your love story, told through timeless imagery and cinematic film</p>
    </div>
    <div class="category-intro fade-in">
        <p>From the quiet nerves before the ceremony to the joy on the dance floor, I'm there to capture every genuine moment, in both stunning photography and cinematic wedding films. My unobtrusive approach means you can be fully present while I preserve the magic of your day. As a Frederick, Maryland wedding photographer and videographer, I travel anywhere your day takes me.</p>
    </div>
    <div class="photo-grid wedding-grid">
        <PhotoSlot name="wedding-featured" label="Featured wedding photo" view="View featured wedding photo" icon="photo" featured />
        <PhotoSlot name="wedding-ceremony" label="Ceremony" view="View ceremony photo" icon="photo" />
        <PhotoSlot name="wedding-reception" label="Reception" view="View reception photo" icon="photo" />
        <PhotoSlot name="wedding-details" label="Details" view="View details photo" icon="photo" />
        <PhotoSlot name="wedding-firstdance" label="First Dance" view="View first dance photo" icon="photo" />
    </div>
    <div class="section-cta fade-in">
        <a href="#contact">Book Your Wedding</a>
    </div>
</section>
