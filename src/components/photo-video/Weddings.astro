<!-- Weddings -->
<section id="weddings">
    <div class="section-header fade-in">
        <h2>Weddings</h2>
        <div class="divider"></div>
        <p>Your love story, told through timeless imagery and cinematic film</p>
    </div>
    <div class="category-intro fade-in">
        <p>From the quiet nerves before the ceremony to the joy on the dance floor, I'm there to capture every genuine moment, in both stunning photography and cinematic wedding films. My unobtrusive approach means you can be fully present while I preserve the magic of your day. As a Frederick, Maryland wedding photographer and videographer, I travel anywhere your day takes me.</p>
    </div>
    <div class="photo-grid wedding-grid">
        <div class="photo-item featured fade-in" data-slot="wedding-featured">
            <div class="photo-placeholder">
                <svg viewBox="0 0 24 24" class="icon-camera"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                Featured wedding photo
            </div>
            <button type="button" class="overlay" aria-label="View featured wedding photo" disabled><span>View</span></button>
        </div>
        <div class="photo-item fade-in" data-slot="wedding-ceremony">
            <div class="photo-placeholder">
                <svg viewBox="0 0 24 24" class="icon-camera"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                Ceremony
            </div>
            <button type="button" class="overlay" aria-label="View ceremony photo" disabled><span>View</span></button>
        </div>
        <div class="photo-item fade-in" data-slot="wedding-reception">
            <div class="photo-placeholder">
                <svg viewBox="0 0 24 24" class="icon-camera"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                Reception
            </div>
            <button type="button" class="overlay" aria-label="View reception photo" disabled><span>View</span></button>
        </div>
        <div class="photo-item fade-in" data-slot="wedding-details">
            <div class="photo-placeholder">
                <svg viewBox="0 0 24 24" class="icon-camera"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                Details
            </div>
            <button type="button" class="overlay" aria-label="View details photo" disabled><span>View</span></button>
        </div>
        <div class="photo-item fade-in" data-slot="wedding-firstdance">
            <div class="photo-placeholder">
                <svg viewBox="0 0 24 24" class="icon-camera"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                First Dance
            </div>
            <button type="button" class="overlay" aria-label="View first dance photo" disabled><span>View</span></button>
        </div>
    </div>
    <div class="section-cta fade-in">
        <a href="#contact">Book Your Wedding</a>
    </div>
</section>
