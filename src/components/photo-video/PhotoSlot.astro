---
// A placeholder tile that the /admin photo manager fills by data-slot.
interface Props {
    /** data-slot key the admin uses */
    name: string;
    label: string;
    /** aria-label for the View button */
    view: string;
    icon: 'photo' | 'person';
    featured?: boolean;
}
const { name, label, view, icon, featured = false } = Astro.props;
---
<div class:list={['photo-item', { featured }, 'fade-in']} data-slot={name}>
    <div class="photo-placeholder">
        {icon === 'photo'
            ? <svg viewBox="0 0 24 24" class="icon-camera"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
            : <svg viewBox="0 0 24 24" class="icon-camera"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>}
        {label}
    </div>
    <button type="button" class="overlay" aria-label={view} disabled><span>View</span></button>
</div>
