---
import { Picture } from 'astro:assets';
import { pricingTiers } from '../data/pricing';
import { text } from '../utils/text';
---
<!-- Pricing -->
<section id="pricing" class="alt-bg">
    <div class="section-header fade-in">
        <h2>Pricing</h2>
        <div class="divider"></div>
        <p>Starting rates for websites, photography, and film</p>
    </div>
    <div class="pricing-tabs fade-in" role="tablist" aria-label="Pricing categories">
        <button type="button" class="pricing-tab active" role="tab" aria-selected="true" data-group="web">Web Design</button>
        <button type="button" class="pricing-tab" role="tab" aria-selected="false" data-group="photo">Photography</button>
        <button type="button" class="pricing-tab" role="tab" aria-selected="false" data-group="video">Videography</button>
    </div>
    <div class="pricing-grid">
        {pricingTiers.map((tier) => (
            <div class:list={['pricing-card', { featured: tier.featured, 'cinematic-card': tier.shot }, 'scale-in']} data-group={tier.groups}>
                {tier.shot && <div class="tier-shot" aria-hidden="true"><Picture src={tier.shot} formats={['avif', 'webp']} widths={[380, 570, 760]} sizes="(max-width: 768px) calc(100vw - 76px), (max-width: 1024px) 45vw, 260px" alt="" loading="lazy" decoding="async" /></div>}
                <h3 set:html={text(tier.name)} />
                <div class="price" set:html={text(tier.price)} />
                <div class="price-note" set:html={text(tier.note)} />
                <ul class="features">
                    {tier.features.map((f) => (
                        <li set:html={text(f)} />
                    ))}
                </ul>
                <a href="#contact" class="pricing-cta" set:html={text(tier.cta)} />
            </div>
        ))}
    </div>
    <p class="pricing-note fade-in">Every project is unique. Prices reflect starting rates: <a href="#contact" style="color: var(--text-accent); text-decoration: none;">reach out</a> for a custom quote tailored to your needs.</p>
</section>
