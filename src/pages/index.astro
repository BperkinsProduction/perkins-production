---
import BaseLayout from '../layouts/BaseLayout.astro';
import Backdrop from '../components/Backdrop.astro';
import Nav from '../components/Nav.astro';
import HeroWheel from '../components/HeroWheel.astro';
import WebDesign from '../components/WebDesign.astro';
import PhotoVideo from '../components/PhotoVideo.astro';
import About from '../components/About.astro';
import Pricing from '../components/Pricing.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import SiteScripts from '../components/SiteScripts.astro';
---
<BaseLayout
    title="Perkins Production | Web Design in Frederick, MD"
    description="Hand-coded websites for Frederick, Maryland businesses, with the photography and film shot by the same person who builds the site. Also portraits, weddings, and 3D tours."
    canonical="https://www.perkinsproduction.com/"
    ogTitle="Perkins Production | Websites that move"
    ogDescription="Hand-coded sites for local businesses, with the photography and film shot by the same person who builds them. Frederick, Maryland."
    ogImage="https://www.perkinsproduction.com/og-image.png"
    ogImageAlt="Perkins Production. Websites that move. Web design in Frederick, Maryland."
>
    <Backdrop />
    <Nav />
    <HeroWheel />
    <WebDesign />
    <PhotoVideo />
    <About />
    <Pricing />
    <Contact />
    <Footer />
    <Lightbox />
    <SiteScripts />
</BaseLayout>
