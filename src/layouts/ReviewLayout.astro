---
// Shell for the client Review Room pages. Private: never indexed, no analytics,
// and the header carries the project name once someone is signed in.
import '../styles/review.css';
import Logo from '../components/Logo.astro';

interface Props {
    title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <meta name="referrer" content="same-origin">
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Slab:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
</head>
<body>
<header class="top">
    <a class="logo" href="/" aria-label="Perkins Production home"><Logo id="gReview" /></a>
    <div class="project">
        <h1 id="projectTitle">Review Room</h1>
        <p id="projectClient"></p>
    </div>
    <div class="who" id="who" hidden>Signed in as <b id="whoName"></b><button id="signOut" type="button">Sign out</button></div>
</header>

<slot />

<footer class="foot">Perkins Production &nbsp;·&nbsp; <a href="mailto:brice@perkinsproduction.com">brice@perkinsproduction.com</a> &nbsp;·&nbsp; (240) 818-1955</footer>
<div class="toast" id="toast" hidden></div>
</body>
</html>
